{
    "name": "@eliware/mysql",
    "type": "module",
    "version": "1.1.6",
    "description": "A simple, dependency-injectable MySQL connection pool utility for Node.js, supporting ESM.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'",
        "lint": "npx oxlint .",
        "pack": "npm pack --dry-run",
        "typecheck": "tsc --project tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/mysql.git"
    },
    "keywords": [
        "mysql",
        "mysql2",
        "nodejs",
        "esm",
        "dependency-injection",
        "connection-pool"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/mysql/issues"
    },
    "homepage": "https://github.com/eliware/mysql#readme",
    "devDependencies": {
        "jest": "^30.4.2",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/log": "^1.1.12",
        "mysql2": "^3.23.3"
    },
    "engines": {
        "node": ">=26"
    }
}
