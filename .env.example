# Example environment variables for @eliware/mysql
MYSQL_HOST=localhost
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
# Optional variables
MYSQL_PORT=3306                 # Default MySQL port
MYSQL_WAIT_FOR_CONNECTIONS=true # true|false|1|0|yes|no|off
MYSQL_CONNECTION_LIMIT=10       # Max connections in pool
MYSQL_QUEUE_LIMIT=0             # Max queued connection requests
MYSQL_READPORT=                 # Optional read-pool port
MYSQL_READHOST=                 # Optional read-pool host
MYSQL_CONNECT_TIMEOUT=          # Optional connection timeout in milliseconds
MYSQL_ACQUIRE_TIMEOUT=          # Optional acquire timeout in milliseconds
MYSQL_SSL=                      # Optional JSON TLS options, or insecure for development
